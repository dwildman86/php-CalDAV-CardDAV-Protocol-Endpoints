{
    "name": "ghostparse/caldav-carddav",
    "description": "Lightweight, dependency-free CalDAV (RFC 4791) and CardDAV (RFC 6352) protocol endpoints for PHP.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "caldav",
        "carddav",
        "webdav",
        "dav",
        "calendar",
        "contacts",
        "icalendar",
        "vcard",
        "sync-collection"
    ],
    "authors": [
        {
            "name": "GhostParse",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-dom": "*",
        "ext-libxml": "*",
        "ext-pdo": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "To store data in SQLite",
        "ext-pdo_mysql": "To store data in MySQL / MariaDB",
        "ext-pdo_pgsql": "To store data in PostgreSQL",
        "ext-mbstring": "For Unicode-aware case-insensitive text matching in REPORT filters"
    },
    "autoload": {
        "psr-4": {
            "GhostParse\\Dav\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GhostParse\\Dav\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/ghostparse-dav"
    ],
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable"
}
